{
  "name": "aqua-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local network music player: Node service + web UI, LX source scripts",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "test": "node --test",
    "start": "node dist/server/index.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.3.0"
  }
}
